RewriteEngine On
RewriteBase /

# 1. Прямой доступ к статическим папкам (без дальнейшей обработки правилами)
RewriteRule ^song-editor/ - [L]
RewriteRule ^apps/ - [L]
RewriteRule ^fire/ - [L]
RewriteRule ^DLE/ - [L] # <--- РАЗРЕШЕНО: прямой доступ к папке уроков

# 2. Короткие ссылки на упражнения
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^library/([a-zA-Z0-9_-]+)$ library/index.php?exercise=$1 [L,QSA]

# 3. Запрет прямого доступа к .php (кроме явно разрешённых)
RewriteCond %{THE_REQUEST} \s/+(.+)\.php [NC]
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteCond %{REQUEST_URI} !^/library/index\.php [NC]
RewriteCond %{REQUEST_URI} !^/library/tree\.php [NC]
RewriteCond %{REQUEST_URI} !^/pro/api\.php [NC]
RewriteCond %{REQUEST_URI} !^/profile\.php [NC]
RewriteCond %{REQUEST_URI} !^/stest/ [NC]
RewriteCond %{REQUEST_URI} !^/ear/ [NC]
RewriteCond %{REQUEST_URI} !^/apps/ [NC]
RewriteCond %{REQUEST_URI} !^/DLE/ [NC] # <--- РАЗРЕШЕНО: выполнение PHP внутри папки DLE
RewriteCond %{REQUEST_URI} !^/blog/ [NC]
RewriteCond %{REQUEST_URI} !^/workspace/ [NC]
RewriteCond %{REQUEST_URI} !^/lessons/ [NC]
RewriteCond %{REQUEST_URI} !^/rudiments/ [NC]


RewriteRule ^ - [R=404,L]

# 4. ЧПУ: Орден (указывает на папку apps/orden)
RewriteRule ^orden/?$ apps/orden/index.php [L]
RewriteRule ^orden/manifest/?$ apps/orden/manifest.php [L]
RewriteRule ^orden/professions/?$ apps/orden/professions.php [L]
RewriteRule ^orden/achievements/?$ apps/orden/achievements.php [L]
RewriteRule ^orden/levels/?$ apps/orden/levels.php [L]
RewriteRule ^orden/ratings/?$ apps/orden/ratings.php [L]
RewriteRule ^orden/shadows/?$ apps/orden/shadows.php [L]

# 5. Остальные страницы
RewriteRule ^sequencer/?$ sequencer/index.php [L]
RewriteRule ^student/([^/]+)$ student/index.php?slug=$1 [L,QSA]
RewriteRule ^$ index.php [L]

# 6. Разрешить статические файлы
<FilesMatch "\.(json|css|js|png|jpg|jpeg|svg|woff2|ico|html)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>